rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read. Writes: signed-in admin, or open until test-mode window ends.
    function canWrite() {
      return request.auth != null
        || request.time < timestamp.date(2026, 9, 12);
    }

    match /{collection}/{doc} {
      allow read: if true;
      allow write: if canWrite();
    }
  }
}
