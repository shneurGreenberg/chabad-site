{
  "name": "Chabad site (Flutter web)",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "flutter-web",
      "command": "export PATH=\"$HOME/flutter/bin:$PATH\"; flutter run -d web-server --web-port 8080 --web-hostname 0.0.0.0",
      "description": "Serves the Flutter web app in debug mode at http://localhost:8080 (supports hot reload with 'r')."
    }
  ],
  "ports": [
    {
      "name": "web server",
      "port": 8080
    }
  ],
  "chromeExecutablePath": "/usr/bin/google-chrome-stable"
}
